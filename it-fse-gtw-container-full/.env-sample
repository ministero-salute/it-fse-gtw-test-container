# Copiare in .env e modificare se necessario: tutte le variabili hanno un default.

# Gruppi di microservizi da avviare: gtw, eds, facade (facade richiede infrastruttura Sogei)
COMPOSE_PROFILES=gtw,eds

# Cartella che contiene i repository dei microservizi (relativa a questa directory).
# Ogni immagine viene compilata dal branch attualmente in checkout nel repository.
FSE_SRC_DIR=../..

# Dump MongoDB (it-fse-catalogs)
MONGO_DUMP_URL=https://raw.githubusercontent.com/ministero-salute/it-fse-catalogs/main/mongo-dump
MONGO_SEED_COLLECTIONS=schema schematron terminology transform engines config_data
# true = riscarica i dump / reimporta le collection al prossimo "up"
MONGO_DUMP_REFRESH=false
MONGO_SEED_FORCE=false

# Limiti di memoria per container
FSE_MS_MEM_LIMIT=768m
FSE_FHIR_MEM_LIMIT=1536m
# fhir-mapping-engine e fhir-validator
FSE_MAPPING_MEM_LIMIT=1536m

# Build in parallelo (ogni build Maven usa ~1.5 GiB: con poca RAM tenere 1-2)
COMPOSE_PARALLEL_LIMIT=2
